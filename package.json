{
  "name": "tunea-tu-combi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Proyecto final de Computación Gráfica - UTEC",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:smoke": "npm run build && playwright test",
    "test:smoke:only": "playwright test",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:smoke"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
